# Base de datos local (SQLite). Para Supabase/Postgres: cambiar provider en prisma/schema.prisma y esta URL.
DATABASE_URL="file:./dev.db"
# Secreto para firmar las sesiones (cualquier string largo y aleatorio)
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
# URL pública, se usa en el QR de los certificados
APP_URL="http://localhost:3000"
